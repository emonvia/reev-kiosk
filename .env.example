# Reev Partner API Configuration
# ---------------------------------
# Base URL of the Reev Partner API (including /api path)
# Production: https://api.reev.com/api
# Dev:        https://api.dev.reev.com/api
REEV_API_URL=https://api.reev.com/api

# OAuth2 token endpoint (Keycloak)
# Production: https://auth.reev.com/realms/partner-api/protocol/openid-connect/token
# Demo:       https://auth.demo.reev.com/realms/partner-api/protocol/openid-connect/token
REEV_AUTH_URL=https://auth.reev.com/realms/partner-api/protocol/openid-connect/token

# OAuth2 client credentials (provided by Reev)
REEV_CLIENT_ID=your-client-id
REEV_CLIENT_SECRET=your-client-secret

# API version (optional, defaults to 2024-08-01)
# REEV_API_VERSION=2024-08-01

# PIN lock for kiosk mode (omit to disable)
# GRID_PIN=1234

# Kiosk display language: en, de, fr, it (defaults to en)
# KIOSK_LOCALE=en
