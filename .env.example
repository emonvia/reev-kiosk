# Reev API Configuration
# ---------------------------------
# Base URL of the Reev API (auth endpoint is derived as {base}/auth)
# Production: https://api.reev.com
# Dev:        https://api.demo.reev.com
REEV_API_URL=https://api.reev.com

# API client credentials (provided by Reev)
REEV_CLIENT_ID=your-client-id
REEV_CLIENT_SECRET=your-client-secret

# API version (optional, defaults to 2024-08-01)
# REEV_API_VERSION=2024-08-01

# PIN lock for kiosk mode (omit to disable)
# GRID_PIN=1234

# Kiosk display language: en, de, fr, it (defaults to en)
# KIOSK_LOCALE=en